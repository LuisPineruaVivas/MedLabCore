*claude

# vite-plugin-pwa dev service worker (regenerated by `npm run dev`)
dev-dist

# Local seed with a copy of production data (patients, auth users). Never commit.
supabase/seed.sql

# Never commit database dumps, backups, CLI scratch or test-tool output
# (purged from git history on 2026-10-21 after the security audit)
supabase/data.sql
backup_*.sql
testsprite_tests/
supabase/.temp/
